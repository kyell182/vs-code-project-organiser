{
  "name": "projects-hub",
  "displayName": "Projects Hub",
  "description": "Save projects, organize them in groups, label them with colored tags and see their status at a glance. Open any project with one click.",
  "version": "0.2.0",
  "publisher": "kyell182",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#2b3a8f",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kyell182/vs-code-project-organiser.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "project",
    "manager",
    "organizer",
    "tags",
    "groups"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "projectsHub",
          "title": "Projects Hub",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "projectsHub": [
        {
          "id": "projectsHub.projects",
          "name": "Projects"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "projectsHub.projects",
        "contents": "No saved projects yet.\n[Save Current Project](command:projectsHub.saveCurrentProject)\n[Add Project Folder](command:projectsHub.addProjectFolder)"
      }
    ],
    "commands": [
      { "command": "projectsHub.saveCurrentProject", "title": "Save Current Project", "category": "Projects Hub", "icon": "$(save)" },
      { "command": "projectsHub.addProjectFolder", "title": "Add Project Folder...", "category": "Projects Hub", "icon": "$(add)" },
      { "command": "projectsHub.openProject", "title": "Open Project", "category": "Projects Hub" },
      { "command": "projectsHub.openProjectInNewWindow", "title": "Open in New Window", "category": "Projects Hub", "icon": "$(empty-window)" },
      { "command": "projectsHub.renameProject", "title": "Rename Project", "category": "Projects Hub" },
      { "command": "projectsHub.removeProject", "title": "Remove Project", "category": "Projects Hub", "icon": "$(trash)" },
      { "command": "projectsHub.togglePin", "title": "Pin / Unpin", "category": "Projects Hub", "icon": "$(pin)" },
      { "command": "projectsHub.setStatus", "title": "Set Status...", "category": "Projects Hub" },
      { "command": "projectsHub.assignGroup", "title": "Move to Group...", "category": "Projects Hub" },
      { "command": "projectsHub.editTags", "title": "Edit Tags...", "category": "Projects Hub", "icon": "$(tag)" },
      { "command": "projectsHub.editNote", "title": "Edit Note...", "category": "Projects Hub", "icon": "$(note)" },
      { "command": "projectsHub.createGroup", "title": "Create Group", "category": "Projects Hub", "icon": "$(new-folder)" },
      { "command": "projectsHub.renameGroup", "title": "Rename Group", "category": "Projects Hub" },
      { "command": "projectsHub.recolorGroup", "title": "Change Group Color", "category": "Projects Hub" },
      { "command": "projectsHub.deleteGroup", "title": "Delete Group", "category": "Projects Hub", "icon": "$(trash)" },
      { "command": "projectsHub.createTag", "title": "Create Tag", "category": "Projects Hub" },
      { "command": "projectsHub.renameTag", "title": "Rename Tag", "category": "Projects Hub" },
      { "command": "projectsHub.recolorTag", "title": "Change Tag Color", "category": "Projects Hub" },
      { "command": "projectsHub.deleteTag", "title": "Delete Tag", "category": "Projects Hub", "icon": "$(trash)" },
      { "command": "projectsHub.switchLayout", "title": "Switch View (Group / Tag / Status)", "category": "Projects Hub", "icon": "$(list-tree)" },
      { "command": "projectsHub.manageStatuses", "title": "Manage Custom Statuses...", "category": "Projects Hub", "icon": "$(symbol-color)" },
      { "command": "projectsHub.openBoard", "title": "Open Project Board", "category": "Projects Hub", "icon": "$(layout)" },
      { "command": "projectsHub.quickSwitch", "title": "Quick Switch Project", "category": "Projects Hub", "icon": "$(search)" }
    ],
    "keybindings": [
      {
        "command": "projectsHub.quickSwitch",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      }
    ],
    "menus": {
      "view/title": [
        { "command": "projectsHub.openBoard", "when": "view == projectsHub.projects", "group": "navigation@0" },
        { "command": "projectsHub.quickSwitch", "when": "view == projectsHub.projects", "group": "navigation@1" },
        { "command": "projectsHub.saveCurrentProject", "when": "view == projectsHub.projects", "group": "navigation@2" },
        { "command": "projectsHub.createGroup", "when": "view == projectsHub.projects", "group": "navigation@3" },
        { "command": "projectsHub.switchLayout", "when": "view == projectsHub.projects", "group": "navigation@4" },
        { "command": "projectsHub.addProjectFolder", "when": "view == projectsHub.projects", "group": "more@1" },
        { "command": "projectsHub.createTag", "when": "view == projectsHub.projects", "group": "more@2" },
        { "command": "projectsHub.manageStatuses", "when": "view == projectsHub.projects", "group": "more@3" }
      ],
      "view/item/context": [
        { "command": "projectsHub.openProjectInNewWindow", "when": "viewItem =~ /^project/", "group": "inline@1" },
        { "command": "projectsHub.togglePin", "when": "viewItem =~ /^project/", "group": "inline@2" },
        { "command": "projectsHub.openProjectInNewWindow", "when": "viewItem =~ /^project/", "group": "1_open@1" },
        { "command": "projectsHub.setStatus", "when": "viewItem =~ /^project/", "group": "2_organize@1" },
        { "command": "projectsHub.assignGroup", "when": "viewItem =~ /^project/", "group": "2_organize@2" },
        { "command": "projectsHub.editTags", "when": "viewItem =~ /^project/", "group": "2_organize@3" },
        { "command": "projectsHub.editNote", "when": "viewItem =~ /^project/", "group": "2_organize@4" },
        { "command": "projectsHub.togglePin", "when": "viewItem =~ /^project/", "group": "2_organize@5" },
        { "command": "projectsHub.renameProject", "when": "viewItem =~ /^project/", "group": "3_edit@1" },
        { "command": "projectsHub.removeProject", "when": "viewItem =~ /^project/", "group": "3_edit@2" },
        { "command": "projectsHub.renameGroup", "when": "viewItem == group", "group": "1_edit@1" },
        { "command": "projectsHub.recolorGroup", "when": "viewItem == group", "group": "1_edit@2" },
        { "command": "projectsHub.deleteGroup", "when": "viewItem == group", "group": "1_edit@3" },
        { "command": "projectsHub.renameTag", "when": "viewItem == tag", "group": "1_edit@1" },
        { "command": "projectsHub.recolorTag", "when": "viewItem == tag", "group": "1_edit@2" },
        { "command": "projectsHub.deleteTag", "when": "viewItem == tag", "group": "1_edit@3" }
      ],
      "commandPalette": [
        { "command": "projectsHub.openProject", "when": "false" },
        { "command": "projectsHub.openProjectInNewWindow", "when": "false" },
        { "command": "projectsHub.renameProject", "when": "false" },
        { "command": "projectsHub.removeProject", "when": "false" },
        { "command": "projectsHub.togglePin", "when": "false" },
        { "command": "projectsHub.setStatus", "when": "false" },
        { "command": "projectsHub.assignGroup", "when": "false" },
        { "command": "projectsHub.editTags", "when": "false" },
        { "command": "projectsHub.editNote", "when": "false" },
        { "command": "projectsHub.recolorGroup", "when": "false" },
        { "command": "projectsHub.renameGroup", "when": "false" },
        { "command": "projectsHub.deleteGroup", "when": "false" },
        { "command": "projectsHub.renameTag", "when": "false" },
        { "command": "projectsHub.recolorTag", "when": "false" },
        { "command": "projectsHub.deleteTag", "when": "false" }
      ]
    },
    "configuration": {
      "title": "Projects Hub",
      "properties": {
        "projectsHub.openInNewWindow": {
          "type": "boolean",
          "default": false,
          "description": "Open projects in a new window instead of the current one."
        },
        "projectsHub.inactiveAfterDays": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "A project without a manual status becomes 'Inactive' when it has not been opened for this many days."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run clean && npm run compile",
    "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && mocha \"out/test/*.test.js\"",
    "test:integration": "npm run compile && node ./out/test/integration/runIntegration.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "mocha": "^10.8.2",
    "typescript": "^5.6.3"
  }
}
